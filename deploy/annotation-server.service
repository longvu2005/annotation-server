[Unit]
Description=RCR annotation web (Review and Positive Selection)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/annotation-server
ExecStart=/usr/bin/python3 /home/ubuntu/annotation-server/server.py --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/annotation-server/data

[Install]
WantedBy=multi-user.target
